  "scripts": {
    "dev": "next dev",
    "dev:vinext": "vinext dev --port 3000",
    "build": "vinext build",
    "build:next": "next build",
    "build:vinext": "vinext build",
    "start": "next start",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json",
