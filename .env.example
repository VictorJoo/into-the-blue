# Supabase Dashboard > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Dashboard > Project Settings > API Keys > Publishable key
# This public browser key is protected by Supabase Auth and RLS policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Google Cloud Console > APIs & Services > Credentials
# Maps JavaScript API와 Places API(Places UI Kit)를 허용하고 HTTP 리퍼러를 제한하세요.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza_REPLACE_ME

# Mapbox Account > Access tokens (지도와 Directions용 공개 토큰, URL 제한 필수)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.REPLACE_ME

# 선택 사항: 자체 OSRM을 사용할 때만 별도로 배포한 인증 경로 Worker 주소
# 생략하면 자동차 경로는 Mapbox Directions API로 계산합니다.
# NEXT_PUBLIC_ROUTE_API_URL=https://into-the-blue-value.YOUR_ACCOUNT_SUBDOMAIN.workers.dev/api/value/route

# Open Graph 등 절대 메타데이터 URL에 쓰는 실제 서비스 주소
NEXT_PUBLIC_SITE_URL=https://YOUR_APP.workers.dev

# 아래 값은 .env.local에 넣지 않고 경로 Worker의 Secret으로만 저장합니다.
# OSRM_BASE_URL=https://osrm-ap-northeast.example.com
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
