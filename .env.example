# Supabase Dashboard > Project Settings > Data API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Dashboard > Project Settings > API Keys > Publishable key
# This public browser key is protected by Supabase Auth and RLS policies.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Google Cloud Console > APIs & Services > Credentials
# Maps JavaScript API와 Routes API를 허용하고 HTTP 리퍼러를 제한하세요.
VITE_GOOGLE_MAPS_API_KEY=AIza_REPLACE_ME

# 가성비 Mapbox + OSRM 버전
# Google 키에는 Maps JavaScript API와 Places UI Kit API만 허용하세요.
VITE_MAP_PROVIDER=mapbox
VITE_MAPBOX_ACCESS_TOKEN=pk.REPLACE_ME
VITE_ROUTE_API_URL=/api/value/route

# wrangler secret put 명령으로 Worker에 저장하는 서버 전용 값
# OSRM_BASE_URL=https://osrm-ap-northeast.example.com
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
