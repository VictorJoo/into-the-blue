# Supabase Dashboard > Project Settings > Data API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Dashboard > Project Settings > API Keys > Publishable key
# This public browser key is protected by Supabase Auth and RLS policies.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Google Cloud Console > APIs & Services > Credentials
# Maps JavaScript API와 Routes API를 허용하고 HTTP 리퍼러를 제한하세요.
VITE_GOOGLE_MAPS_API_KEY=AIza_REPLACE_ME
